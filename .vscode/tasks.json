{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Spēle",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "client.main"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": [],
            "presentation": {"panel": "dedicated", "clear": true}
        },
        {
            "label": "Serveris",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "uvicorn", "api.main:app", "--host", "127.0.0.1", "--port", "8000"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": [],
            "presentation": {"panel": "dedicated", "clear": true}
        },
        {
            "label": "Testi",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "pytest", "-q"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": "test",
            "problemMatcher": [],
            "presentation": {"panel": "dedicated", "clear": true}
        }
    ]
}