{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Spēle",
            "type": "debugpy",
            "request": "launch",
            "module": "client.main",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Serveris",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["api.main:app", "--host", "127.0.0.1", "--port", "8000"],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "jinja": true,
            "justMyCode": true
        }
    ]
}